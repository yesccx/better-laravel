# 默认时间格式 'Y-m-d H:i:s'
YBL_DATE_FORMAT=

# 异常处理-忽略异常栈信息
YBL_EX_IGNORE_TRACKS=

# 异常处理-忽略异常后的描述
YBL_EX_IGNORED_SUMMARY=

# 异常处理-Missing异常描述
YBL_EX_MISSING_SUMMARY=

# 使用异常错误码作为HTTP响应码
YBL_EX_USE_EXCEPTION_CODE=

# k8s容器环境标识
CLOUDLADDER_DEPLOY_ENV=

# 运行环境配置-环境键
YBL_RUNTIME_ENVIRONMENT_KEY="CLOUDLADDER_DEPLOY_ENV"

# 运行环境配置-灰度环境值
YBL_RUNTIME_GRAY_ENVIRONMENT_VALUE="gray"

# 运行环境配置-生产环境值
YBL_RUNTIME_PROD_ENVIRONMENT_VALUE="prod"